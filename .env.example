# Public site URL used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://dynamicmediaconsultants.com

# Where lead form submissions are delivered (JSON POST).
# Works with Zapier / Make / Keap (Infusionsoft) / HubSpot / any webhook catcher.
# If unset, the form validates but tells visitors to call or email instead.
CONTACT_WEBHOOK_URL=

# Optional shared secret sent as the X-Webhook-Secret header.
CONTACT_WEBHOOK_SECRET=

# Optional: scheduling link (Calendly, Google Calendar booking page, etc.).
# When set, a "Pick a time" button appears on the consultation page.
NEXT_PUBLIC_BOOKING_URL=

# Optional: Google Analytics 4 measurement ID (G-XXXXXXX).
NEXT_PUBLIC_GA_ID=
